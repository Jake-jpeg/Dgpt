# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env — secrets never in source
.env
.env.local
.env*.local

# database (SQLite dev/test files)
*.db
*.db-journal
prisma/dev.db*
prisma/test.db*

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts

# session file-transfer artifacts (never commit; may contain env values)
_to_delete/snapshot-*.tar.gz
*.tar.gz

# local file storage (synthetic uploads; never in source)
/data/

# ── CONFIDENTIAL: real client documents (stipulations, PII) — NEVER commit/push ──
# Kept OUT of the repo entirely (sibling folder); these patterns are a backstop
# in case anything ever lands inside the tree.
.gitseriouslyignore/
Dgpt-Stips/
*-CONFIDENTIAL/
