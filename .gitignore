# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env — secrets never in source
.env
.env.local
.env*.local

# database (SQLite dev/test files)
*.db
*.db-journal
prisma/dev.db*
prisma/test.db*

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts

# session file-transfer artifacts (never commit; may contain env values)
_to_delete/snapshot-*.tar.gz
*.tar.gz

# local file storage (synthetic uploads; never in source)
/data/

# ── CONFIDENTIAL: real client documents (stipulations, PII) — NEVER commit/push ──
# Kept OUT of the repo entirely (sibling folder); these patterns are a backstop
# in case anything ever lands inside the tree.
.gitseriouslyignore/
Dgpt-Stips/
*-CONFIDENTIAL/

# agent scratch — retired files parked by coding agents mid-session.
# Two reasons both lines matter: these are NOT ignored by any pattern above,
# so a stray `git add .` would publish them to this PUBLIC repo; and a
# retired route left here still imports modules that the live tree has
# deleted, which failed `next build` on a file that is not even in the repo
# (2026-10-30, _agent_trash/start-ask-retired). tsconfig.json excludes the
# same two paths from type checking.
/_agent_trash/
/_agent_tmp/
