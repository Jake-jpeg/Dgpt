# ─────────────────────────────────────────────────────────────
# DivorceGPT 2.0 — Stage 1 environment
# No secrets in source. Copy to .env and fill in. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# SQLite database file path (built on node:sqlite — no native deps).
# All SQL is confined to src/lib/db/; see README for the Postgres migration note.
DATABASE_PATH=./data/dev.db

# 32+ char random secret used to sign session cookies (HS256).
# Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS

# Separate salt for audit-trail name hashing (conflict-hit audit records store
# HMAC(name, AUDIT_HASH_SECRET), never the name itself).
AUDIT_HASH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_CHARS

# Public URL of the app (OAuth redirect URIs are derived from this).
APP_URL=http://localhost:3000

# ── Client login: Google OAuth (OIDC code flow + PKCE) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Attorney login: Microsoft Entra ID (separate role + auth path) ──────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated allowlist of attorney/paralegal emails. An Entra login whose
# email is not on this list is rejected — tenant membership alone is not enough.
ATTORNEY_EMAILS=

# ── Dev auth stub ──────
# "true" enables /api/auth/dev-login for local testing WITHOUT real OAuth
# credentials. Hard-disabled when NODE_ENV=production regardless of this flag.
DEV_AUTH_STUB=false

# ── Beta test login (production, closed testing ONLY) ──────
# "true" exposes the same test sign-in IN PRODUCTION, but only while the beta
# gate is up (FREE_ACCESS_KEYS set) and only to requests that already carry a
# valid beta-key cookie. Identity is NOT verified — anyone with a beta key
# can sign in as any email. Synthetic data only. REMOVE BEFORE PUBLIC LAUNCH.
BETA_TEST_LOGIN=false

# ── Beta access gate ──────
# When non-empty, the ENTIRE site is gated behind an access-code screen
# (/beta). Comma-separated so you can hand out several codes and revoke them
# individually — removing a code here locks its holders out on their next
# request (the cookie stores the code and is re-checked every request).
# Leave empty to disable the gate (site fully open).
FREE_ACCESS_KEYS=

# Cloudflare Turnstile CAPTCHA on the beta gate (bot protection).
# Create a widget at https://dash.cloudflare.com → Turnstile, then paste both
# keys. If either is unset, the CAPTCHA step is skipped (code-only gate).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Retention policy ──────
# Sessions with no activity for this many days are treated as abandoned:
# substantive data purged, minimal audit kept. Enforced by /api/admin/purge.
RETENTION_ABANDONED_DAYS=14

# Secret for admin/cron endpoints (retention purge).
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET
