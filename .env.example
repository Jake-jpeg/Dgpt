# ─────────────────────────────────────────────────────────────
# Anthropic (Claude)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Model is env-driven via src/lib/ai-config.ts.
# Default (when this var is unset) is claude-opus-4-8 (Claude Opus 4.8).
# DivorceGPT runs on Opus. Leave unset in prod to use the Opus default,
# or pin it explicitly here:
ANTHROPIC_MODEL=claude-opus-4-8

# Stripe
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE

# Free access keys (comma-separated, for testing/promos)
FREE_ACCESS_KEYS=

# Resend (email service)
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Where monitor alerts are sent (defaults to admin@divorcegpt.com)
MONITOR_ALERT_TO=admin@divorcegpt.com

# Monitor secret for cron/admin endpoints
MONITOR_SECRET=YOUR_MONITOR_SECRET_HERE

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Maintenance mode (set to "true" to enable)
NEXT_PUBLIC_MAINTENANCE_MODE=false
