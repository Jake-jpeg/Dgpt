# ─────────────────────────────────────────────────────────────
# DivorceGPT 2.0 — attorney-workflow environment
# No secrets in source. Copy to .env and fill in. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# PRODUCTION: set DATABASE_URL and the app runs on PostgreSQL. App Platform
# containers are EPHEMERAL — with SQLite, every deploy destroyed all users
# and matters. On DigitalOcean with the managed DB attached, use the
# bindable value so credentials never live in config:
#   DATABASE_URL=${dgpt-db.DATABASE_URL}
# TLS: with sslmode=require in the URL, the connection is encrypted; set
# DATABASE_CA_CERT (e.g. ${dgpt-db.CA_CERT}) to also verify the chain.
#DATABASE_URL=
#DATABASE_CA_CERT=

# LOCAL DEV / TESTS (DATABASE_URL absent): SQLite file via node:sqlite —
# zero native deps, ":memory:" in the test suite. Same SQL either way; the
# engines differ only inside src/lib/db/driver.ts.
DATABASE_PATH=./data/dev.db

# 32+ char random secret used to sign session cookies (HS256).
# Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS

# Separate salt for audit-trail name hashing (audit records store
# HMAC(name, AUDIT_HASH_SECRET), never the name itself).
AUDIT_HASH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_CHARS

# Public URL of the app (OAuth redirect URIs + CSRF origin check).
# No trailing slash. Wrong value ⇒ every POST 403s.
APP_URL=http://localhost:3000

# ── Deployment stage ──────
# local | staging | closed_pilot. Unset/unknown ⇒ local (most restrictive
# posture; the ONLY stage where the development login can exist). Drives the
# landing page's stage-aware status copy.
APP_STAGE=local

# ── Branding (display values only — NEVER a secret in NEXT_PUBLIC_*) ──
NEXT_PUBLIC_OPERATING_FIRM_NAME=Jake Kim Law Firm
# Inquiry mailbox for public pages. [NOT CONFIGURED] ⇒ neutral fallback text.
NEXT_PUBLIC_INQUIRY_EMAIL=
# Operator/IP identity (docs/OPERATOR-AND-IP-OWNERSHIP.md). The legal-services
# provider is ALWAYS the operating firm and is not separately configurable.
# Software owner is [OWNER CONFIRMATION REQUIRED] — leave empty until the
# owner confirms; public copy omits it rather than guessing.
NEXT_PUBLIC_PORTAL_OPERATOR=
NEXT_PUBLIC_SOFTWARE_OWNER=
NEXT_PUBLIC_COPYRIGHT_OWNER=

# ── Client login: Google OAuth (OIDC code flow + PKCE + nonce) ──────
# Scopes requested: openid email profile — never Gmail/Drive/Calendar.
# Google sign-in alone creates NOTHING; a firm invitation binds the account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact redirect override (defaults to {APP_URL}/api/auth/callback/google).
GOOGLE_REDIRECT_URI=

# ── Firm-side login: Microsoft Entra ID (single-tenant ONLY) ──────
# MICROSOFT_* is canonical; the original ENTRA_* names are still honored.
# The tenant must be the firm's specific tenant id — 'common', 'consumers',
# and 'organizations' are refused at configuration time. Scopes requested:
# openid email profile — never Microsoft Graph mail/files/calendar/Teams.
# A successful Microsoft sign-in confers NOTHING by itself: an ACTIVE
# admin-created app account is required, and roles reload from the DB on
# every protected request.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional exact redirect override (defaults to {APP_URL}/api/auth/callback/entra).
MICROSOFT_REDIRECT_URI=
# Legacy names (still honored if the MICROSOFT_* names are unset):
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated allowlist re-checked on EVERY attorney request.
ATTORNEY_EMAILS=

# ── Roles ──────
# ADMIN bootstrap/recovery ONLY (narrow scope): a listed email self-provisions
# the ADMIN role at first login. Ordinary role management lives in the DB via
# the admin API (/api/admin/users).
ADMIN_EMAILS=

# ── Consent capture ──────
# "true" additionally records IP + user-agent with disclosure
# acknowledgments. DISABLED by default on purpose.
CONSENT_CAPTURE_IP_UA=false

# ── File storage ──────
# Local development storage directory (outside public/). Production object
# storage is [NOT CONFIGURED]; local storage REFUSES NODE_ENV=production
# unless FILE_STORAGE_ALLOW_LOCAL_TEST=true is set explicitly for testing.
FILE_STORAGE_DIR=./data/files
FILE_STORAGE_ALLOW_LOCAL_TEST=false
# Max upload size in MB (default 15).
MAX_UPLOAD_MB=15

# ── AI (server-only) ──────────────────────────────────────────────────
# Master kill switch. "false" ⇒ zero provider calls; the portal, intake,
# uploads, document review, and manual workflows all keep working.
AI_FEATURES_ENABLED=false
#
# ONE SWITCH. This moves the ENTIRE platform — the client intake bot and the
# attorney workbench — between providers. Set it plus that provider's key and
# you are done. DELETE IT to roll everything back.
#   anthropic (default) | openai
AI_PROVIDER=anthropic
#
# Keys stay named per provider on purpose: they are different credentials from
# different vendors with different billing. One shared row would turn "wrong
# key pasted" into a silent cross-vendor auth failure and leave a stale secret
# in a row nobody remembers is live. Only the ACTIVE provider's key is read.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
#
# Two tiers, because they are genuinely different jobs. Leave both blank to
# take the provider's defaults:
#   intake     narrow — the sequencer owns question order, the machine owns the
#              gates, the server disposes every proposal; the model only phrases
#              the step.        anthropic→claude-haiku-4-5  openai→gpt-5.6-terra
#   workbench  the attorney's document analysis and internal actions — real case
#              material, real work product.
#                               anthropic→claude-sonnet-5   openai→gpt-5.6-terra
#
# NOTE for the openai path: the closest analogue to Sonnet for workbench work is
# gpt-5.6-sol, not Terra (Terra is the balanced production tier). Terra is what
# was asked for; set AI_MODEL_WORKBENCH=gpt-5.6-sol if the output reads thinner.
# gpt-5.6-luna is the cheap tier ($1/$6 vs Terra's $2.50/$15) and is a
# reasonable intake experiment.
AI_MODEL_INTAKE=
AI_MODEL_WORKBENCH=
#
# Pin ONE tier to a different provider — an experiment lever, not the normal
# control. Leave blank unless you are deliberately running a split.
AI_PROVIDER_WORKBENCH=
#
# Request bounds (defaults shown). Retries never apply to 4xx.
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_RETRIES=2
#
# DEV-ONLY endpoint overrides (offline mock servers). Both are REFUSED in
# production builds, so live traffic can never be redirected off the official
# endpoint.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
#
# SUPERSEDED 2026-08-01, still honoured on the anthropic path so an environment
# configured earlier keeps working. Prefer the AI_* rows above.
#   ANTHROPIC_MODEL          → AI_MODEL_WORKBENCH (and intake fallback)
#   ANTHROPIC_INTAKE_MODEL   → AI_MODEL_INTAKE
#   INTAKE_MODEL             → AI_MODEL_INTAKE
#   INTAKE_AI_PROVIDER       → AI_PROVIDER
# ANTHROPIC_REVIEW_MODEL was DELETED: it was documented here for months and
# read by no code at all.

# ── Conversational intake (docs/CONVERSATIONAL-INTAKE-SPEC.md) ─────────
# Kill switch. Unset/not "true" ⇒ the chat endpoint answers 503 and clients
# use the classic form, which always works regardless of this setting.
INTAKE_CHAT_ENABLED=true
# Per-turn timeout, deliberately well inside DigitalOcean's ~30s gateway
# limit so a slow turn returns a friendly retry, never a gateway error.
INTAKE_TURN_TIMEOUT_MS=20000
# Expectation set in the scripted opening message ("this can take up to N
# hours; you can pause and return anytime").
INTAKE_EXPECTED_HOURS=2
# Assistant tone (Constitution 2026-07.2, Amendment 1):
#   WARM    = default. Full Rule 11: one brief, genuine acknowledgment when
#             the client shares something personal, then back to the question.
#   NEUTRAL = courteous and patient, acknowledgments compressed to a minimal
#             polite beat. For deployments optimising throughput.
# Unset or unrecognised ⇒ WARM. Recorded in every transcript alongside the
# constitution version.
INTAKE_TONE=WARM
# Who a stopped intake is directed to (Rule 7 stop message).
FIRM_CONTACT=

# Opt-in LIVE smoke test. Never runs by default; prints metadata only and
# never prints the key.
RUN_OPENAI_SMOKE=false

# ── Legal-content snapshot governance (see docs/legal-authority/) ──────
# Version label of the counsel-reviewed authority snapshot (empty ⇒ warning).
LEGAL_CONTENT_VERSION=
# Date counsel last reviewed the snapshot (YYYY-MM-DD; empty ⇒ warning).
LEGAL_CONTENT_REVIEWED_AT=
# Max snapshot age in days before REVIEW_AGE_EXCEEDED warnings (default 180).
LEGAL_CONTENT_MAX_AGE_DAYS=180
# LOCAL-ONLY development aid for internal surfaces. Startup REFUSES this flag
# outside APP_STAGE=local. It never enables client-facing conclusions.
ALLOW_UNAPPROVED_LEGAL_CONTENT=false

# ── Dev auth stub (LOCAL ONLY) ──────
# "true" enables /api/auth/dev-login — but ONLY when APP_STAGE=local AND
# NODE_ENV is not production. In staging/closed_pilot/production the route is
# a neutral 404 no matter what, and setting this flag there triggers a loud
# startup warning.
DEV_AUTH_STUB=false

# ── Legacy beta gate (NOT the ordinary entry point) ──────
# The 2.0 entry point is firm invitations. The old beta gate only activates
# when BOTH BETA_GATE_ENABLED=true AND FREE_ACCESS_KEYS is non-empty.
BETA_GATE_ENABLED=false
FREE_ACCESS_KEYS=
# Beta-era test login (triple-locked; see AGENTS.md). Remove before launch.
BETA_TEST_LOGIN=false
# Cloudflare Turnstile CAPTCHA on the beta gate (skipped when unset).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Retention ──────
# Legacy session-level sweep threshold (matterless sessions).
RETENTION_ABANDONED_DAYS=14
# Matter-level retention thresholds are ADMIN-CONFIGURABLE in-app
# (PUT /api/admin/config): retention.prospective_days,
# retention.abandoned_days, retention.sweep_enabled.
# Final policy values are [COUNSEL REVIEW REQUIRED].

# Bearer secret for machine endpoints (retention purge cron). Unset ⇒ 503.
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET

# --- Firm signature block on the NY Verified Complaint -----------------------
# Leave every row EMPTY to use the generator defaults (Jake Kim Law Firm,
# 2460 Lemoine Avenue, Suite 400H, Fort Lee, New Jersey 07024).
# Set them to print a different block — e.g. a New York office address, which
# Judiciary Law § 470 requires of a NY-admitted attorney who RESIDES outside
# New York. Use a literal \n in the address for the second line.
FIRM_ATTORNEY_NAME=
FIRM_ATTORNEY_FIRM=
FIRM_ATTORNEY_ADDRESS=
FIRM_ATTORNEY_PHONE=

